# Publish only the maintained project surface; local browser/account assets stay local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/package.json
!/build.mjs
!/LICENSE
!/README.md
!/TESTING.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CHANGELOG.md
!/.github/
!/tools/
!/src/
/src/*
!/src/engine.js
!/src/framework/
!/src/sites/
!/tests/
/tests/*
!/tests/framework-tests.mjs
!/tests/build.test.mjs
!/tests/dom-fixture.js
!/dist/
/dist/*
!/dist/local-ui-zh.user.js

# Defense in depth for future files under allowed directories.
**/node_modules/
**/.env
**/.env.*
**/*.log
**/*.dpapi
**/*.pem
**/*.key
**/.DS_Store
